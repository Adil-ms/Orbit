# ── ORBIT API server ─────────────────────────────────────────────
PORT=8787
APP_BASE_URL=http://localhost:5174          # used to build links in WhatsApp messages
LINK_SIGNING_SECRET=change-me-to-a-long-random-string   # required in production
LINK_TTL_HOURS=72
# ORBIT_DB_PATH=./server/data/orbit.db

# ── AI checklist suggestions (optional; rule-based checklist works without it) ──
# ANTHROPIC_API_KEY=sk-ant-...
# ORBIT_AI_MODEL=claude-opus-5-5
# ORBIT_AI_EFFORT=medium
# ORBIT_AI_ENABLED=true

# ── WhatsApp Business Platform (Cloud API) — omit for mock mode ──
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_REMINDER=orbit_trip_reminder
# WHATSAPP_TEMPLATE_UPDATE=orbit_checklist_update
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_MODE=mock|cloud

# ── Reminders & scoring ──────────────────────────────────────────
REMINDER_OFFSETS_HOURS=24,3
UPDATE_BATCH_SECONDS=120
# ORBIT_SCORING_JSON={"regularItem":10,"essentialDocumentItem":20}

# Web push — backup notifications when WhatsApp fails. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com   # defaults to APP_BASE_URL when it is https
